# Safe defaults. Mock mode never writes to an external platform.
PUBLISH_ENABLED=false
PUBLISH_MOCK=true
PUBLISH_REPOSITORY=sqlite
PUBLISH_SQLITE_PATH=.data/publish.db
PUBLISH_JSON_PATH=.data/publish-state.json
PUBLISH_WORKER_INTERVAL_MS=30000
PUBLISH_WORKER_LIMIT=20
PUBLISH_STABLE_AFTER_HOURS=72
PUBLISH_VERIFICATION_TIMEOUT_HOURS=168

# Authenticated local bridge.
PUBLISH_BRIDGE_URL=http://127.0.0.1:9528
PUBLISH_BRIDGE_TOKEN=
PUBLISH_BRIDGE_PORT=9528
PUBLISH_HTTP_PORT=8787
PUBLISH_REQUIRE_AUTHORIZATION_ACCEPTANCE=true
PUBLISH_AUTHORIZATION_PATH=.data/authorization.json

# Optional event webhook.
PUBLISH_WEBHOOK_URL=
PUBLISH_WEBHOOK_SECRET=

# WeChat Official Account official API executor.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
