# AI providers: configure only the providers you use.
DASHSCOPE_API_KEY=
QWEN_MODEL=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com

DOUBAO_API_KEY=
DOUBAO_MODEL=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

AI_PROVIDER_TIMEOUT_MS=120000

# Safe defaults: mock mode performs no external platform writes.
DIRECT_PUBLISH_ENABLED=false
DIRECT_PUBLISH_MOCK=true
DIRECT_PUBLISH_TIMEOUT_MS=120000
WECHATSYNC_BRIDGE_URL=http://127.0.0.1:9528
WECHATSYNC_BRIDGE_TOKEN=
DIRECT_PUBLISH_STABLE_AFTER_HOURS=72
DIRECT_PUBLISH_VERIFICATION_TIMEOUT_HOURS=168
PUBLISH_JOB_STORE_PATH=.data/publish-jobs.json
