{
  "name": "content-publish-engine",
  "version": "0.1.0",
  "description": "AI content production and multi-platform publish engine for the Chinese content ecosystem",
  "license": "MIT",
  "keywords": [
    "content-publishing",
    "mcp",
    "wechat",
    "juejin",
    "csdn",
    "zhihu"
  ],
  "type": "module",
  "exports": {
    "./content-production": {
      "types": "./dist/packages/content-production/index.d.ts",
      "default": "./dist/packages/content-production/index.js"
    },
    "./free-production": {
      "types": "./dist/packages/free-production/index.d.ts",
      "default": "./dist/packages/free-production/index.js"
    },
    "./publish-engine": {
      "types": "./dist/packages/publish-engine/index.d.ts",
      "default": "./dist/packages/publish-engine/index.js"
    },
    "./platforms": "./dist/packages/platforms/index.mjs",
    "./ai-provider": {
      "types": "./dist/packages/ai-provider/index.d.ts",
      "default": "./dist/packages/ai-provider/index.js"
    },
    "./mcp-server": "./dist/servers/publish-mcp-server.mjs"
  },
  "bin": {
    "content-publish-engine-mcp": "./dist/servers/publish-mcp-server.mjs"
  },
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "tsc && node scripts/copy-runtime-files.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.*js",
    "test:package": "node scripts/package-smoke.mjs",
    "check:syntax": "node scripts/check-mjs.mjs",
    "check": "npm run typecheck && npm run check:syntax && npm test && npm run build && npm run test:package",
    "mcp:start": "node --import tsx servers/publish-mcp-server.mjs",
    "mcp:start:dist": "node dist/servers/publish-mcp-server.mjs",
    "prebuild": "npm run clean",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.7.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    ".env.example",
    "docs/",
    "examples/"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
